# Linux server
SRT_PUBLIC_URL=https://subtitles.example.com
SRT_ALLOWED_ORIGINS=https://subtitles.example.com,http://localhost:5173
SRT_DATA_DIR=./data/server
SRT_SESSION_SECRET=replace-with-a-long-random-secret
SRT_COOKIE_SECURE=true
SRT_ADMIN_USERNAME=admin
SRT_ADMIN_PASSWORD=replace-this-password
SRT_SESSION_DAYS=14

# Douyin downloader
SRT_DOUYIN_ENABLED=true
# Use "admin" for the first canary period, then switch to "authenticated".
SRT_DOUYIN_ACCESS=authenticated
SRT_DOUYIN_COOKIE_FILE=
# Inline fallback when a mounted secret file is unavailable.
SRT_DOUYIN_COOKIE=
SRT_BHWA_API_BASE=https://downloader-api.bhwa233.com

# Server-side Douyin speech-to-text
SRT_TRANSCRIPTION_ENABLED=true
# local: run the Linux worker; fc: submit asynchronous Function Compute tasks.
SRT_TRANSCRIPTION_BACKEND=local
SRT_TRANSCRIPTION_THREADS=2
SRT_TRANSCRIPTION_MAX_DURATION_SECONDS=1800
SRT_TRANSCRIPTION_MAX_SOURCE_BYTES=524288000
SRT_TRANSCRIPTION_MEDIA_RETENTION_HOURS=168
SRT_TRANSCRIPTION_MEDIA_QUOTA_BYTES=10737418240
SRT_TRANSCRIPTION_USER_QUEUE_LIMIT=3
SRT_TRANSCRIPTION_GLOBAL_QUEUE_LIMIT=20

# Alibaba Cloud FC + OSS (required when SRT_TRANSCRIPTION_BACKEND=fc)
SRT_FC_ENDPOINT=123456789.cn-hangzhou.fc.aliyuncs.com
SRT_FC_FUNCTION_NAME=srt-sub-transcription
SRT_FC_QUALIFIER=LATEST
SRT_FC_CALLBACK_SECRET=replace-with-at-least-32-random-characters
SRT_FC_STALE_JOB_SECONDS=3900
SRT_FC_QUEUE_MAX_AGE_SECONDS=86400
SRT_OSS_REGION=cn-hangzhou
SRT_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
SRT_OSS_BUCKET=replace-with-private-bucket
SRT_OSS_PREFIX=douyin-transcriptions
SRT_OSS_MEDIA_URL_TTL_SECONDS=600
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=

# Prohibited-word detection (OpenAI Chat Completions compatible)
SRT_MODERATION_API_BASE=https://api.example.com/v1
SRT_MODERATION_API_KEY=replace-with-api-key
SRT_MODERATION_MODEL=replace-with-model-name
SRT_MODERATION_TIMEOUT_SECONDS=30

# Local agent
SRT_AGENT_DATA_DIR=
SRT_AGENT_ALLOWED_ORIGINS=https://subtitles.example.com,http://localhost:5173
SRT_AGENT_PORT=43921
